<!DOCTYPE html>

<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>SkillSet - Modern Learning Management Dashboard</title>
<!-- Tailwind CSS v3 with Forms & Container Plugins -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Tailwind Custom Configuration -->
<script data-purpose="tailwind-config">
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f5f3ff',
              100: '#ede9fe',
              200: '#ddd6fe',
              400: '#a78bfa',
              500: '#7c3aed',
              600: '#6366f1',
              700: '#5824c9',
              800: '#4338ca',
            },
            canvas: '#f4f5fc',
            coral: '#ff6b6b',
            amberAccent: '#f59e0b',
            emeraldAccent: '#10b981'
          },
          boxShadow: {
            'soft-card': '0 8px 30px rgba(0, 0, 0, 0.04)',
            'hover-card': '0 14px 40px rgba(99, 102, 241, 0.12)',
            'glow-purple': '0 10px 25px -3px rgba(91, 77, 251, 0.35)',
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
          }
        }
      }
    }
  </script>
<!-- Font Awesome CDN for Interface Icons -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
<!-- Component Layout Styling -->
<style data-purpose="custom-scrollbars">
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
<!-- Micro-interactions & Visual Effects -->
<style data-purpose="custom-decorations">
    .glass-effect {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
    }
    .gradient-hero-bg {
      background: linear-gradient(135deg, #6366f1 0%, #7c3aed 55%, #8b5cf6 100%);
    }
    .pro-card-gradient {
      background: linear-gradient(145deg, #f8f9ff 0%, #ede9fe 100%);
    }
  </style>
</head>
<body class="bg-[#f4f5fc] text-slate-700 min-h-screen font-sans flex antialiased selection:bg-brand-500 selection:text-white">
<!-- BEGIN: SidebarNavigation -->
<aside class="w-64 bg-white border-r border-slate-100 flex flex-col shrink-0 justify-between fixed top-0 bottom-0 left-0 z-30 transition-all duration-300" data-purpose="sidebar-container">
<div class="flex flex-col h-full overflow-y-auto px-5 py-6">
<!-- Brand Logo Header -->
<div class="flex items-center gap-3 px-3 mb-8">
<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-brand-500/30">
<i class="fa-solid fa-graduation-cap text-lg"></i>
</div>
<div>
<span class="text-xl font-black tracking-tight text-slate-800">Skill<span class="text-brand-600">Set</span></span>
<span class="block text-[10px] uppercase font-bold text-slate-400 tracking-wider">E-Learning Hub</span>
</div>
</div>
<!-- Navigation Section: Main Menu -->
<div class="space-y-6">
<div>
<p class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Main Menu</p>
<nav class="space-y-1">
<a class="flex items-center gap-3.5 px-3.5 py-2.5 rounded-xl font-medium text-sm text-brand-600 bg-brand-50/80 transition-all group" href="#">
<i class="fa-solid fa-house-chimney text-base"></i>
<span>Dashboard</span>
<span class="ml-auto w-1.5 h-4 rounded-full bg-brand-600"></span>
</a>
<a class="flex items-center gap-3.5 px-3.5 py-2.5 rounded-xl font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all" href="#">
<i class="fa-solid fa-play-circle text-base text-slate-400"></i>
<span>My Courses</span>
</a>
<a class="flex items-center gap-3.5 px-3.5 py-2.5 rounded-xl font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all" href="#">
<i class="fa-regular fa-compass text-base text-slate-400"></i>
<span>Browse Courses</span>
</a>
<a class="flex items-center gap-3.5 px-3.5 py-2.5 rounded-xl font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all" href="#">
<i class="fa-regular fa-clipboard-check text-base text-slate-400"></i>
<span>Assignments</span>
</a>
<a class="flex items-center gap-3.5 px-3.5 py-2.5 rounded-xl font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all" href="#">
<i class="fa-solid fa-certificate text-base text-slate-400"></i>
<span>Certificates</span>
</a>
<a class="flex items-center gap-3.5 px-3.5 py-2.5 rounded-xl font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all" href="#">
<i class="fa-solid fa-chart-line text-base text-slate-400"></i>
<span>Leaderboard</span>
</a>
<a class="flex items-center gap-3.5 px-3.5 py-2.5 rounded-xl font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all" href="#">
<i class="fa-solid fa-user-group text-base text-slate-400"></i>
<span>Community</span>
</a>
</nav>
</div>
<!-- Navigation Section: Preferences & Support -->
<div>
<p class="px-3 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Preferences</p>
<nav class="space-y-1">
<a class="flex items-center gap-3.5 px-3.5 py-2.5 rounded-xl font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all" href="#">
<i class="fa-solid fa-sliders text-base text-slate-400"></i>
<span>Settings</span>
</a>
<a class="flex items-center gap-3.5 px-3.5 py-2.5 rounded-xl font-medium text-sm text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition-all" href="#">
<i class="fa-regular fa-circle-question text-base text-slate-400"></i>
<span>Help Center</span>
</a>
</nav>
</div>
</div>
<!-- Upgrade to Pro Card -->
<div class="mt-8 pro-card-gradient border border-brand-100 p-4 rounded-2xl text-center relative overflow-hidden" data-purpose="pro-subscription-banner">
<div class="w-10 h-10 mx-auto rounded-full bg-white shadow-sm flex items-center justify-center text-brand-600 mb-2">
<i class="fa-solid fa-bolt text-lg"></i>
</div>
<h4 class="font-bold text-slate-800 text-sm">Upgrade to Pro</h4>
<p class="text-xs text-slate-500 mt-1 mb-3.5 leading-relaxed">Unlock 1,500+ masterclasses &amp; personal AI mentorship</p>
<button class="w-full py-2 px-3 bg-brand-600 hover:bg-brand-700 text-white font-medium text-xs rounded-xl shadow-md shadow-brand-500/25 transition-all flex items-center justify-center gap-1.5">
<span>Upgrade Now</span>
<i class="fa-solid fa-arrow-right text-[10px]"></i>
</button>
</div>
</div>
</aside>
<!-- END: SidebarNavigation -->
<!-- BEGIN: MainContentWrapper -->
<div class="ml-64 flex-1 flex flex-col min-w-0">
<!-- BEGIN: TopNavigationBar -->
<header class="h-20 bg-white/70 backdrop-blur-md border-b border-slate-100 sticky top-0 z-20 flex items-center justify-between px-8" data-purpose="dashboard-header">
<!-- Search Field -->
<div class="w-96 relative">
<span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
<i class="fa-solid fa-magnifying-glass text-sm"></i>
</span>
<input class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border-transparent rounded-2xl text-xs sm:text-sm text-slate-700 placeholder-slate-400 focus:bg-white focus:border-brand-400 focus:ring-2 focus:ring-brand-100 transition-all" placeholder="Search courses, instructors, topics..." type="text"/>
</div>
<!-- Right Top Actions & Profile -->
<div class="flex items-center gap-4">
<!-- Live Status Indicator Pill -->
<span class="inline-flex items-center gap-2 px-3 py-1 bg-red-50 text-red-500 rounded-full text-xs font-semibold border border-red-100/80 animate-pulse">
<span class="w-2 h-2 rounded-full bg-red-500"></span>
          2 Live Classes
        </span>
<!-- Dark/Light Theme Button -->
<button class="w-10 h-10 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-500 flex items-center justify-center transition-all border border-slate-100">
<i class="fa-regular fa-moon text-sm"></i>
</button>
<!-- Notification Bell Icon -->
<button class="relative w-10 h-10 rounded-xl bg-slate-50 hover:bg-slate-100 text-slate-500 flex items-center justify-center transition-all border border-slate-100">
<i class="fa-regular fa-bell text-sm"></i>
<span class="absolute top-2.5 right-2.5 w-2 h-2 bg-brand-600 rounded-full ring-2 ring-white"></span>
</button>
<div class="h-8 w-px bg-slate-200 mx-1"></div>
<!-- User Profile Quick Info -->
<div class="flex items-center gap-3 pl-1 cursor-pointer">
<div class="relative">
<div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-400 to-rose-400 flex items-center justify-center text-white font-bold shadow-sm ring-2 ring-white">
              IS
            </div>
<span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-white"></span>
</div>
<div class="text-left hidden lg:block">
<h5 class="text-sm font-semibold text-slate-800 leading-tight">Irham M. Shidiq</h5>
<p class="text-[11px] font-medium text-slate-400">Senior Student</p>
</div>
<i class="fa-solid fa-chevron-down text-[10px] text-slate-400 hidden lg:block"></i>
</div>
</div>
</header>
<!-- END: TopNavigationBar -->
<!-- BEGIN: DashboardBody -->
<main class="p-8 space-y-8 flex-1">
<!-- Hero Welcome Banner -->
<section class="gradient-hero-bg rounded-3xl p-8 text-white relative overflow-hidden shadow-glow-purple" data-purpose="welcome-hero-banner">
<!-- Abstract Decorative Shapes -->
<div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
<div class="absolute right-36 top-6 w-32 h-32 bg-purple-400/20 rounded-full blur-xl pointer-events-none"></div>
<div class="relative z-10 max-w-2xl">
<span class="px-3 py-1 rounded-full bg-white/20 text-xs font-semibold uppercase tracking-wider backdrop-blur-sm inline-block mb-3">
            📚 Welcome back, Irham!
          </span>
<h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl text-white">
            Ready to keep learning today?
          </h1>
<p class="mt-2.5 text-purple-100 text-sm leading-relaxed max-w-xl">
            You have 2 pending assignments and 1 live module coming up in 45 minutes. Continue your daily track to maintain your 3-day learning streak!
          </p>
<div class="mt-6 flex flex-wrap gap-3 items-center">
<button class="px-5 py-2.5 bg-white text-brand-700 hover:bg-purple-50 font-semibold text-sm rounded-xl shadow-md transition-all flex items-center gap-2">
<i class="fa-solid fa-circle-play text-brand-600"></i>
              Resume Last Course
            </button>
<button class="px-5 py-2.5 bg-brand-700/40 hover:bg-brand-700/60 border border-white/20 text-white font-medium text-sm rounded-xl backdrop-blur-sm transition-all">
              Explore New Catalog
            </button>
</div>
</div>
<!-- 3D-Like Graphic Representation inside Hero (Vector Graphic Composition) -->
<div class="hidden xl:flex absolute right-12 bottom-6 items-end gap-3 pointer-events-none">
<div class="w-16 h-36 bg-amber-400 rounded-lg shadow-lg rotate-[-6deg] border-2 border-white/20 flex flex-col justify-between p-2">
<div class="w-full h-1 bg-white/40 rounded"></div>
<span class="text-[9px] font-bold text-slate-800 tracking-widest text-center transform -rotate-90">UX/UI</span>
<div class="w-full h-2 bg-amber-500 rounded"></div>
</div>
<div class="w-16 h-48 bg-rose-400 rounded-lg shadow-xl -rotate-1 border-2 border-white/20 flex flex-col justify-between p-2">
<div class="w-full h-1 bg-white/40 rounded"></div>
<span class="text-[9px] font-bold text-white tracking-widest text-center transform -rotate-90">PYTHON</span>
<div class="w-full h-2 bg-rose-500 rounded"></div>
</div>
<div class="w-20 h-40 bg-indigo-300 rounded-lg shadow-lg rotate-6 border-2 border-white/20 flex flex-col justify-between p-2">
<div class="w-full h-1 bg-white/40 rounded"></div>
<span class="text-[9px] font-bold text-indigo-900 tracking-widest text-center transform -rotate-90">DESIGN</span>
<div class="w-full h-2 bg-indigo-400 rounded"></div>
</div>
</div>
</section>
<!-- Quick Metrics 4-Column Grid -->
<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5" data-purpose="learning-progress-metrics">
<!-- Metric 1: Courses Completed -->
<div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-soft-card flex items-center gap-4 hover:-translate-y-0.5 transition-all">
<div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg font-bold">
<i class="fa-solid fa-book-bookmark"></i>
</div>
<div>
<span class="text-xs font-medium text-slate-400">Courses Completed</span>
<h3 class="text-2xl font-black text-slate-800">3</h3>
</div>
</div>
<!-- Metric 2: Certificates Earned -->
<div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-soft-card flex items-center gap-4 hover:-translate-y-0.5 transition-all">
<div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center text-lg font-bold">
<i class="fa-solid fa-award"></i>
</div>
<div>
<span class="text-xs font-medium text-slate-400">Certificates Earned</span>
<h3 class="text-2xl font-black text-slate-800">2</h3>
</div>
</div>
<!-- Metric 3: Hours Learned -->
<div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-soft-card flex items-center gap-4 hover:-translate-y-0.5 transition-all">
<div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center text-lg font-bold">
<i class="fa-regular fa-clock"></i>
</div>
<div>
<span class="text-xs font-medium text-slate-400">Hours Learned</span>
<h3 class="text-2xl font-black text-slate-800">18.5 <span class="text-xs font-semibold text-slate-400">hrs</span></h3>
</div>
</div>
<!-- Metric 4: Daily Streak -->
<div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-soft-card flex items-center gap-4 hover:-translate-y-0.5 transition-all">
<div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-500 flex items-center justify-center text-lg font-bold">
<i class="fa-solid fa-fire-flame-curved"></i>
</div>
<div>
<span class="text-xs font-medium text-slate-400">Daily Streak</span>
<h3 class="text-2xl font-black text-slate-800">3 <span class="text-xs font-semibold text-slate-400">Days</span></h3>
</div>
</div>
</section>
<!-- Main Layout Grid: Primary Content Area (2/3) + Secondary Sidebar (1/3) -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
<!-- Left Column: Continue Learning & Course Library (Span 2) -->
<div class="lg:col-span-2 space-y-8">
<!-- Continue Learning Section -->
<section data-purpose="continue-learning-widget">
<div class="flex items-center justify-between mb-4">
<h2 class="text-lg font-bold text-slate-800 tracking-tight">Continue Learning</h2>
<a class="text-xs font-semibold text-brand-600 hover:text-brand-700" href="#">View History</a>
</div>
<!-- Horizontal Active Progress Course Card -->
<div class="bg-white rounded-2xl border border-slate-100 p-5 shadow-soft-card flex flex-col sm:flex-row items-center gap-5 hover:border-brand-200 transition-all">
<!-- Thumbnail Illustration Box -->
<div class="w-full sm:w-36 h-28 rounded-xl bg-gradient-to-br from-indigo-500 to-purple-600 flex flex-col justify-center items-center text-white shrink-0 relative overflow-hidden">
<i class="fa-brands fa-python text-4xl mb-1 text-white/90"></i>
<span class="text-[10px] font-bold tracking-widest uppercase">Module 4 of 6</span>
<span class="absolute top-2 left-2 bg-white/20 text-white text-[9px] font-bold px-2 py-0.5 rounded backdrop-blur-sm">70% Completed</span>
</div>
<!-- Course Info & Progress Bar -->
<div class="flex-1 w-full">
<div class="flex items-center justify-between">
<span class="text-[11px] font-bold text-indigo-600 uppercase tracking-wider bg-indigo-50 px-2.5 py-0.5 rounded-full">Coding</span>
<span class="text-xs font-semibold text-slate-400">2 lessons left</span>
</div>
<h3 class="text-base font-bold text-slate-800 mt-1.5">Mastering Python Basics &amp; Architecture</h3>
<p class="text-xs text-slate-500 mt-0.5">Next Topic: Object-Oriented Patterns &amp; Abstract Classes</p>
<!-- Progress Line Indicator -->
<div class="mt-3.5">
<div class="flex justify-between text-xs font-semibold text-slate-500 mb-1.5">
<span>Progress</span>
<span class="text-brand-600 font-bold">68%</span>
</div>
<div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
<div class="h-full bg-brand-600 rounded-full w-[68%] transition-all duration-500"></div>
</div>
</div>
</div>
<!-- Resume Button -->
<div class="shrink-0 w-full sm:w-auto">
<button class="w-full sm:w-auto px-5 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-medium text-xs rounded-xl shadow-md shadow-brand-500/20 transition-all flex items-center justify-center gap-2">
<span>Resume</span>
<i class="fa-solid fa-arrow-right text-[10px]"></i>
</button>
</div>
</div>
</section>
<!-- Popular Courses Catalog Grid -->
<section data-purpose="popular-courses-grid">
<div class="flex items-center justify-between mb-4">
<div>
<h2 class="text-lg font-bold text-slate-800 tracking-tight">Popular &amp; Recommended</h2>
<p class="text-xs text-slate-400">Handpicked programs aligned with your goals</p>
</div>
<a class="text-xs font-semibold text-brand-600 hover:text-brand-700" href="#">View All</a>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-5">
<!-- Card 1: UI/UX Design -->
<article class="bg-white rounded-2xl border border-slate-100 p-4 shadow-soft-card hover:shadow-hover-card transition-all flex flex-col justify-between group">
<div>
<div class="relative w-full h-40 rounded-xl bg-gradient-to-tr from-amber-100 via-rose-100 to-violet-100 flex items-center justify-center overflow-hidden mb-3.5">
<div class="w-20 h-20 rounded-2xl bg-white/80 backdrop-blur-sm shadow-sm flex items-center justify-center text-amber-500 group-hover:scale-105 transition-all">
<i class="fa-solid fa-bezier-curve text-3xl"></i>
</div>
<button class="absolute top-2.5 right-2.5 w-8 h-8 rounded-full bg-white/80 hover:bg-white text-slate-400 hover:text-rose-500 flex items-center justify-center transition-all">
<i class="fa-regular fa-bookmark text-xs"></i>
</button>
<span class="absolute bottom-2.5 left-2.5 bg-amber-500 text-white font-bold text-[10px] uppercase px-2 py-0.5 rounded-md">
                      Design
                    </span>
</div>
<div class="flex items-center gap-2 mb-1.5">
<span class="text-amber-500 text-xs flex items-center gap-1">
<i class="fa-solid fa-star text-[11px]"></i> 4.9
                    </span>
<span class="text-slate-300">•</span>
<span class="text-xs text-slate-400">25 Lessons</span>
</div>
<h4 class="font-bold text-slate-800 text-sm group-hover:text-brand-600 transition-colors line-clamp-1">
                    UI/UX Design Fundamentals &amp; Figma
                  </h4>
<p class="text-xs text-slate-500 mt-1 line-clamp-2">
                    Learn core visual hierarchy, auto layout systems, and interactive wireframing from industry leads.
                  </p>
</div>
<div class="flex items-center justify-between pt-4 mt-3 border-t border-slate-50">
<div class="flex items-center gap-2">
<div class="w-6 h-6 rounded-full bg-slate-200 text-[10px] font-bold flex items-center justify-center text-slate-600">MR</div>
<span class="text-xs text-slate-600 font-medium">Michael R.</span>
</div>
<span class="text-sm font-black text-brand-600">$48.00</span>
</div>
</article>
<!-- Card 2: Startup Fundamentals -->
<article class="bg-white rounded-2xl border border-slate-100 p-4 shadow-soft-card hover:shadow-hover-card transition-all flex flex-col justify-between group">
<div>
<div class="relative w-full h-40 rounded-xl bg-gradient-to-tr from-emerald-100 via-teal-100 to-cyan-100 flex items-center justify-center overflow-hidden mb-3.5">
<div class="w-20 h-20 rounded-2xl bg-white/80 backdrop-blur-sm shadow-sm flex items-center justify-center text-emerald-500 group-hover:scale-105 transition-all">
<i class="fa-solid fa-rocket text-3xl"></i>
</div>
<button class="absolute top-2.5 right-2.5 w-8 h-8 rounded-full bg-white/80 hover:bg-white text-slate-400 hover:text-rose-500 flex items-center justify-center transition-all">
<i class="fa-regular fa-bookmark text-xs"></i>
</button>
<span class="absolute bottom-2.5 left-2.5 bg-emerald-500 text-white font-bold text-[10px] uppercase px-2 py-0.5 rounded-md">
                      Business
                    </span>
</div>
<div class="flex items-center gap-2 mb-1.5">
<span class="text-amber-500 text-xs flex items-center gap-1">
<i class="fa-solid fa-star text-[11px]"></i> 4.8
                    </span>
<span class="text-slate-300">•</span>
<span class="text-xs text-slate-400">32 Lessons</span>
</div>
<h4 class="font-bold text-slate-800 text-sm group-hover:text-brand-600 transition-colors line-clamp-1">
                    Startup Scale-Up &amp; Lean Validation
                  </h4>
<p class="text-xs text-slate-500 mt-1 line-clamp-2">
                    Master modern business mechanics, pitch preparation, and customer acquisition channels.
                  </p>
</div>
<div class="flex items-center justify-between pt-4 mt-3 border-t border-slate-50">
<div class="flex items-center gap-2">
<div class="w-6 h-6 rounded-full bg-slate-200 text-[10px] font-bold flex items-center justify-center text-slate-600">RT</div>
<span class="text-xs text-slate-600 font-medium">Robert T.</span>
</div>
<span class="text-sm font-black text-brand-600">$59.00</span>
</div>
</article>
<!-- Card 3: Cloud Architecture -->
<article class="bg-white rounded-2xl border border-slate-100 p-4 shadow-soft-card hover:shadow-hover-card transition-all flex flex-col justify-between group">
<div>
<div class="relative w-full h-40 rounded-xl bg-gradient-to-tr from-sky-100 via-indigo-100 to-purple-100 flex items-center justify-center overflow-hidden mb-3.5">
<div class="w-20 h-20 rounded-2xl bg-white/80 backdrop-blur-sm shadow-sm flex items-center justify-center text-indigo-500 group-hover:scale-105 transition-all">
